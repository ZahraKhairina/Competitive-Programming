#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int main() {
        ll n, l, r;
        cin >> n >> l >> r;
        
        vector<ll> a(n);
        for (ll i = 0; i < n; i++) cin >> a[i];
        
        for (ll i = 0; i < n; i++){
            if (a[i] < l) {
                cout << l << " ";
            }
            else if (a[i] > r){
                cout << r << " ";
            }
            else cout << a[i] << " ";
        }
}
