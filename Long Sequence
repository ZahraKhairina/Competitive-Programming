#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int main(){
    ll n;
    cin >> n;
    vector<ll> a(n);
    ll sum = 0;
    for (ll i = 0; i < n; i++){
        cin >> a[i];
        sum += a[i];
    }
    
    ll x;
    cin >> x;
    
    ll sum2 = 0;
    ll ans = 0;
    if (sum == x){
        cout << n << endl;
    }
    else if (sum < x){
        ll r = x / sum;
        sum2 = r * sum;
        ans = r * n;
        
        for (ll i = 0; i < n; i++){
            sum2 += a[i];
            ans++;
            if (sum2 > x){
                 cout << ans << endl;
                 break;
            }
        }
    }
    else {
       for (ll i = 0; i < n; i++){
           sum2 += a[i];
           ans++;
           if (sum2 > x){
               cout << ans << endl;
               break;
           }
       } 
    }
}
