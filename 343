#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

bool palindrome(ll n){
  string s = to_string(n);
  string t = s;
  reverse(t.begin(), t.end());
  return s == t;
}

int main() {
  ll n;
  cin >> n;
  ll ans = 0;
  for (ll i = 1; i * i * i <= n; i++){
    if(palindrome(i*i*i)) ans = i*i*i;
  }

  cout << ans << endl;
}
