#include<bits/stdc++.h>
using namespace std;
typedef long long ll;

ll MAXA = 200000;

int main(){
  ll n;
  cin >> n;
  if (n < 0) return 0;

  vector<ll> freq(200005, 0);
  for (ll i = 0; i < n; i++){
    ll x;
    cin >> x;
    freq[x]++;
  }

  ll ans = 0;
  for(ll i = 1; i <= MAXA; i++){
    if (freq[i] == 0)continue;

    for (ll j = 1; i*j <= MAXA; j++){
      if (freq[j] == 0) continue;

      ll target = i*j;
      if (freq[target] > 0) ans += freq[i]*freq[j]*freq[target];
    }
  }

  cout << ans << endl;
}
