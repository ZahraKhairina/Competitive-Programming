#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

int main() {
  ll n, k;
  cin >> n >> k;

  vector<vector<ll>> group(k);
  vector<ll> a(n);

  for (ll i = 0; i < n; i++){
    cin >> a[i];
    group[i%k].push_back(a[i]);
  }

  for (ll i = 0; i < k; i++){
    sort(group[i].begin(), group[i].end());
  }

  vector<ll> b = a;
  sort(b.begin(), b.end());

  for (ll i = 0; i < n; i++){
    ll x = i % k;
    ll y = i / k;
    a[i] = group[x][y];
  }

  for (ll i = 0; i < n; i++){
    if (a[i] != b[i]){
      cout << "No" << endl;
      return 0;
    }
  }

  cout << "Yes" << endl;
}
