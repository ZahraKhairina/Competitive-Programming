#include <bits/stdc++.h>
using namespace std;
typedef long long ll;

ll nonkuadrat(ll x){

  ll res = x;
  for (ll i = 2; i*i <=res; i++){
    while(res % (i*i) == 0){
      res /= i*i;
    }
  }

  return res;
}

int main() {
  ll n;
  cin >> n;
  vector<ll> a(n);

  unordered_map<ll, ll> freq;

  ll zero = 0;
  for (ll i = 0; i < n; i++){
    cin >> a[i];

    if (a[i] == 0) zero++;
    else {
      freq[nonkuadrat(a[i])]++;
    }
  }

  ll ans = 0;
  ll nonzero = n - zero;
  ans += nonzero * zero;
  ans += (zero)*(zero-1) / 2;

  for (auto [gakkuadrat, banyak] : freq){
    ans += (banyak)*(banyak -1)/ 2;
  }

  cout << ans << endl;
}

